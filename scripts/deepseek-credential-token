#!/usr/bin/env bash
# Cross-platform (macOS + Linux) credential helper. Reads a DeepSeek API key
# from the OS-native secret store and prints it to stdout with no trailing
# newline. Never logs, decorates, or echoes the token; all diagnostics go to
# stderr. Shared by both harnesses: Codex calls this via
# model_providers.deepseek.auth.command (service name passed as args[0]);
# claude-deepseek calls it directly to populate ANTHROPIC_AUTH_TOKEN.
#
# Windows has no equivalent shell for this file — see scripts/windows/deepseek-credential-token.ps1.
#
# Usage: deepseek-credential-token <service-name>
#   e.g. deepseek-credential-token deepseek-api-codex
set -euo pipefail

SERVICE="${1:-}"
if [ -z "$SERVICE" ]; then
  echo "deepseek-credential-token: usage: deepseek-credential-token <service-name>" >&2
  exit 2
fi
ACCOUNT="$USER"
OS="$(uname -s)"

case "$OS" in
  Darwin)
    if ! command -v security >/dev/null 2>&1; then
      echo "deepseek-credential-token: macOS 'security' command not found" >&2
      exit 127
    fi
    TOKEN="$(security find-generic-password -a "$ACCOUNT" -s "$SERVICE" -w 2>/dev/null)" || {
      echo "deepseek-credential-token: no credential in macOS Keychain (service=$SERVICE, account=$ACCOUNT)" >&2
      echo "deepseek-credential-token: store it with:" >&2
      echo "  security add-generic-password -a \"\$USER\" -s $SERVICE -w -U" >&2
      exit 1
    }
    ;;
  Linux)
    if ! command -v secret-tool >/dev/null 2>&1; then
      echo "deepseek-credential-token: 'secret-tool' not found on PATH" >&2
      echo "deepseek-credential-token: install it — e.g. 'apt install libsecret-tools' (Debian/Ubuntu) or 'dnf install libsecret' (Fedora)" >&2
      exit 127
    fi
    TOKEN="$(secret-tool lookup service "$SERVICE" account "$ACCOUNT" 2>/dev/null)" || {
      echo "deepseek-credential-token: no credential in the Secret Service (service=$SERVICE, account=$ACCOUNT)" >&2
      echo "deepseek-credential-token: store it with:" >&2
      echo "  secret-tool store --label=\"DeepSeek API key ($SERVICE)\" service $SERVICE account \"\$USER\"" >&2
      echo "deepseek-credential-token: requires a running Secret Service provider (GNOME Keyring, KWallet via ksecrets, or similar)." >&2
      echo "deepseek-credential-token: headless/server Linux without a login keyring session needs a different credential backend — not covered by this kit." >&2
      exit 1
    }
    ;;
  *)
    echo "deepseek-credential-token: unsupported OS '$OS' — this helper covers macOS and Linux only" >&2
    echo "deepseek-credential-token: on Windows, use scripts\\windows\\deepseek-credential-token.ps1 instead" >&2
    exit 1
    ;;
esac

if [ -z "$TOKEN" ]; then
  echo "deepseek-credential-token: credential found but empty (service=$SERVICE)" >&2
  exit 1
fi

# printf, not echo: avoids a trailing newline in the bearer token.
printf '%s' "$TOKEN"
