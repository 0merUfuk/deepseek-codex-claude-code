#!/usr/bin/env bash
# Command-backed auth helper for Codex's model_providers.<name>.auth.command.
# Codex treats stdout as the literal bearer token: never log, decorate, or
# append a trailing newline to it here. All diagnostics go to stderr.
set -euo pipefail

# Distinct from the Claude Code service name on purpose: if you also run
# claude-deepseek, this should hold a DIFFERENT DeepSeek API key than its
# deepseek-api-claudecode service. It's the distinct keys (not just the
# distinct service names) that let each tool's usage be attributed
# separately on the DeepSeek dashboard, and let you rotate one without
# touching the other.
KEYCHAIN_SERVICE="deepseek-api-codex"
KEYCHAIN_ACCOUNT="$USER"

if ! command -v security >/dev/null 2>&1; then
  echo "deepseek-keychain-token: macOS 'security' command not found" >&2
  exit 127
fi

TOKEN="$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null)" || {
  echo "deepseek-keychain-token: no credential in Keychain (service=$KEYCHAIN_SERVICE, account=$KEYCHAIN_ACCOUNT)" >&2
  echo "deepseek-keychain-token: store it with:" >&2
  echo "  security add-generic-password -a \"\$USER\" -s $KEYCHAIN_SERVICE -w -U" >&2
  exit 1
}

if [ -z "$TOKEN" ]; then
  echo "deepseek-keychain-token: Keychain item found but empty" >&2
  exit 1
fi

# printf, not echo: avoids a trailing newline in the bearer token.
printf '%s' "$TOKEN"
