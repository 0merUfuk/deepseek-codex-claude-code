# Copy to ~/.codex/deepseek.config.toml
# Current Codex --profile behavior layers this file over ~/.codex/config.toml.
# Re-check current Codex + DeepSeek docs before use.

model = "deepseek-v4-flash"
model_provider = "deepseek"
model_reasoning_effort = "high"

# "~" here IS expanded by Codex's config loader for this field (confirmed by
# testing with a deliberately broken path: Codex errored on load rather than
# silently ignoring it). Portable across machines/usernames as written.
# Verified on macOS; re-verify tilde-expansion on Linux and Windows before
# relying on it there — not independently confirmed on either yet.
model_catalog_json = "~/.codex/deepseek.models.json"

# Optional extra caution for a third-party/unfamiliar model: require your
# own approval on risky actions, and keep this profile's session from
# triggering your normal hook automations. Harmless, off by default, remove
# if you don't want the extra prompts.
# approvals_reviewer = "user"
# [features]
# hooks = false

[model_providers.deepseek]
name = "DeepSeek"
base_url = "https://api.deepseek.com/"
wire_api = "responses"

# Codex invokes this command and uses its trimmed stdout as the bearer
# token; the key never sits in this file. Unlike model_catalog_json above,
# "~" is NOT expanded here — bare name on PATH, or a fully-qualified path.
#
# macOS / Linux (see scripts/deepseek-credential-token):
[model_providers.deepseek.auth]
command = "deepseek-credential-token"
args = ["deepseek-api-codex"]

# Windows — comment out the two lines above and use this instead. Untested
# on Windows Codex; verify empirically (see docs/setup-codex.md) before
# relying on it.
# [model_providers.deepseek.auth]
# command = "powershell"
# args = [
#   "-NoProfile", "-ExecutionPolicy", "Bypass",
#   "-File", "C:\\Users\\<you>\\.codex\\scripts\\deepseek-credential-token.ps1",
#   "deepseek-api-codex",
# ]
